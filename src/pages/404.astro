---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="404 - Nixon Correa" description="Page not found" noindex={true}>
  <div class="topbar">
    <div class="wrap">
      <Nav />
    </div>
  </div>

  <main id="main" class="nf wrap">
    <p class="nf__code" aria-hidden="true">404</p>
    <h1 class="nf__title">Page not found</h1>
    <p class="nf__text">The link you tried to access doesn't exist or was moved.</p>
    <p class="nf__text">But don't worry, you can go back home and keep browsing.</p>
    <div class="actions">
      <a class="btn" href="/">Back to home</a>
      <a class="link" href="/#work">View projects</a>
    </div>
  </main>

  <Footer />
</Layout>
