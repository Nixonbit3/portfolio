---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import MailLink from "../components/MailLink.astro";

import brickBreaker from "../assets/img-projects/brick-breaker.webp";
import airBomb from "../assets/img-projects/air-bomb.webp";
import fractureTool from "../assets/img-projects/fracture-tool.webp";
import mate from "../assets/img-projects/mate4k.webp";

// Los textos van en ingles (idioma por defecto). La version en espanol se
// aplica en el navegador con el diccionario de src/scripts/i18n.js.
const proyectos = [
  {
    titulo: "Brick Breaker Mobile",
    imagen: brickBreaker,
    alt: "Brick Breaker Mobile title screen",
    texto:
      "A brick breaker for phones that also runs in the browser. It has five generated levels, lives, a high score, pause, audio settings, analytics and rewarded ads on Android.",
    stack: "Android and WebGL. Unity, C#, DOTween.",
    enlaces: [
      { texto: "Play in the browser", url: "https://nixonbit3.itch.io/brick-breaker-mobile" },
    ],
  },
  {
    titulo: "Air Bomb",
    imagen: airBomb,
    alt: "Air Bomb title art",
    texto:
      "A Space Invaders-style arcade shooter for Android. Levels are ScriptableObjects, systems talk through events, progress is saved as JSON and the audio carries across scenes.",
    stack: "Android. Unity, C#, DOTween.",
    enlaces: [{ texto: "Play on itch.io", url: "https://nixonbit3.itch.io/air-bomb" }],
  },
  {
    titulo: "Fracture Tool",
    imagen: fractureTool,
    alt: "Fracture Tool Pro cover showing a wall breaking into glass and stone fragments",
    texto:
      "A Unity Asset Store tool that breaks any mesh into physics fragments. It started as my final degree project and is now published as a Free and a Pro edition under my brand, Naxo Studios. Cuts can be baked in the editor, so a 4,000-triangle column breaks in about 3 ms instead of 490 ms.",
    stack: "Editor tooling. Unity, C#, PhysX.",
    enlaces: [
      {
        texto: "Get Free",
        url: "https://assetstore.unity.com/packages/tools/physics/fracture-tool-free-410372",
      },
      {
        texto: "Get Pro",
        url: "https://assetstore.unity.com/packages/tools/physics/fracture-tool-pro-410486",
      },
    ],
  },
  {
    titulo: "Realistic 3D Mate Gourd",
    imagen: mate,
    alt: "Realistic yerba mate gourd on grass",
    texto: "A yerba mate gourd modeled in Blender and textured in Substance Painter.",
    stack: "3D art. Blender, Substance Painter.",
    enlaces: [{ texto: "View on ArtStation", url: "https://www.artstation.com/artwork/8wnkNQ" }],
  },
];

const principios = [
  {
    titulo: "Logic and presentation stay apart",
    texto:
      "I use a View and Controller split. Viewers animate and report what happened, controllers decide what it means. Services such as audio, analytics and ads sit outside both.",
  },
  {
    titulo: "Levels are data",
    texto:
      "Level definitions live in ScriptableObjects, so a designer can change a level without touching code and a new level never needs a new script.",
  },
  {
    titulo: "Systems talk through events",
    codigo: true,
    texto:
      "Classes announce what happened with C# events and subscribe and unsubscribe in OnDestroy, so nothing holds a reference it no longer needs.",
  },
  {
    titulo: "Everything runs on a real phone",
    texto:
      "I test builds on real devices and chase bugs with stack traces and prefab reference checks before I call a build done.",
  },
];

const herramientas = [
  { grupo: "Languages and engines", items: "C#, C++, Python, Unity, Unreal Engine" },
  {
    grupo: "Gameplay and architecture",
    items:
      "ScriptableObjects, DOTween, data-driven design, event-driven architecture, JSON persistence",
  },
  { grupo: "Mobile", items: "Android builds, UI and HUD systems, testing on real devices" },
  {
    grupo: "Art, 3D and process",
    items:
      "Blender, Maya, 3ds Max, Substance Painter, Photoshop, Figma, Git, Scrum and Kanban",
  },
];
const datosPersona = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Nixon Correa",
  jobTitle: "Junior Developer",
  url: "https://nixondanielcorrea.netlify.app",
  image: "https://nixondanielcorrea.netlify.app/og.jpg",
  address: { "@type": "PostalAddress", addressLocality: "Barcelona", addressCountry: "ES" },
  alumniOf: "Centre de la Imatge i la Tecnologia Multimèdia (CITM), UPC",
  knowsAbout: ["C#", "C++", "Python", "Unity", "Game development", "Android"],
  sameAs: [
    "https://www.linkedin.com/in/nixon-correa",
    "https://github.com/Nixonbit3",
    "https://nixonbit3.itch.io",
    "https://sketchfab.com/nixoncorrea",
  ],
};
---

<Layout>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(datosPersona)} />
  <div class="xp" aria-hidden="true"><span class="xp__fill"></span></div>
  <div class="toast" role="status" aria-live="polite"></div>

  <header class="band hero">
    <div class="wrap">
      <Nav />

      <div class="hero__grid">
        <h1 class="hero__name"><span>Nixon</span><span>Correa</span></h1>

        <aside class="inspector" aria-label="Profile summary">
          <div class="inspector__head">
            <span class="inspector__check" aria-hidden="true"></span>
            <span class="inspector__title notranslate">Nixon Correa</span>
            <span class="inspector__tag notranslate">(Developer)</span>
          </div>
          <dl class="inspector__body">
            <div class="field" style="--i:0"><dt>Based in</dt><dd>Barcelona, open to remote work</dd></div>
            <div class="field" style="--i:1"><dt>Looking for</dt><dd>A first programming role, in games or in any other kind of software</dd></div>
            <div class="field" style="--i:2">
              <dt>Published</dt>
              <dd>
                <ul class="field__list">
                  <li>Air Bomb (Android)</li>
                  <li>Brick Breaker Mobile (Android and web)</li>
                  <li>Fracture Tool (Unity Asset Store)</li>
                </ul>
              </dd>
            </div>
            <div class="field" style="--i:3">
              <dt>Open to work</dt>
              <dd class="field__bool"><span class="toggle" aria-hidden="true"></span>Yes</dd>
            </div>
          </dl>
        </aside>
        <div class="hero__lead">
          <p>
            I'm a junior developer who learned to program by building games. I have shipped two
            mobile games and a published Unity tool, all written in C# and made alone from first
            prototype to release.
          </p>
          <div class="actions">
            <a class="btn" href="https://nixonbit3.itch.io/brick-breaker-mobile" target="_blank" rel="noopener noreferrer"><span class="btn__icon" aria-hidden="true"></span>Play Brick Breaker in your browser</a>
            <a class="link" href="/cv">Read the resume</a>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main id="main">
    <section class="section" id="work" aria-labelledby="work-title">
      <div class="wrap">
        <div class="section__head">
          <h2 class="section__title" id="work-title">Selected work</h2>
          <p class="section__note">Two shipped games, one published Unity tool and one 3D piece.</p>
        </div>

        <div class="work">
          {
            proyectos.map((p, i) => (
              <article class="row">
                <div class="row__img">
                  <Image
                    src={p.imagen}
                    alt={p.alt}
                    widths={[400, 640, 960]}
                    sizes="(max-width: 900px) 100vw, 42vw"
                    format="webp"
                    quality={75}
                    loading={i === 0 ? "eager" : "lazy"}
                    decoding="async"
                  />
                </div>
                <div class="row__body">
                  <h3 class="row__title">{p.titulo}</h3>
                  <p class="row__text">{p.texto}</p>
                  <p class="row__stack">{p.stack}</p>
                  <div class="row__links">
                    {p.enlaces.map((e) => (
                      <a href={e.url} target="_blank" rel="noopener noreferrer">
                        {e.texto}
                      </a>
                    ))}
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section approach" id="approach" aria-labelledby="approach-title">
      <div class="wrap">
        <div class="section__head">
          <h2 class="section__title" id="approach-title">How I build</h2>
          <p class="section__note">The habits behind both games, written down.</p>
        </div>
        <div class="principles">
          {
            principios.map((p) => (
              <div class="principle">
                <h3>{p.titulo}</h3>
                <p>{p.texto}</p>
                {p.codigo && (
                  <span class="sr-only">Example in C#</span>
                  <pre class="code notranslate" translate="no"><code><span class="k">public event</span> <span class="t">Action</span>&lt;<span class="t">int</span>&gt; OnScoreChanged;

<span class="k">void</span> OnDestroy()
{`{`}
    model.OnScoreChanged <span class="k">-=</span> HandleScore;
{`}`}</code></pre>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" id="background" aria-labelledby="background-title">
      <div class="wrap">
        <div class="section__head">
          <h2 class="section__title" id="background-title">Background</h2>
        </div>
        <div class="bg-grid">
          <div class="bg-col bg-col--a">
            <h3 class="col-title">Experience and education</h3>
            <div class="entry">
              <h4>IT Support Technician</h4>
              <p class="entry__meta">Col·legi d'Arquitectes de Catalunya (COAC), Barcelona. March to August 2025.</p>
              <ul>
                <li>Designed gamified cybersecurity training for staff, applying game mechanics to real learning.</li>
                <li>Built interactive PDF forms and edited institutional videos to the organisation's standards.</li>
              </ul>
            </div>
            <div class="entry">
              <h4>BSc in Video Game Design and Development</h4>
              <p class="entry__meta">CITM, Universitat Politècnica de Catalunya, Barcelona. September 2021 to July 2025.</p>
            </div>
          </div>
          <div class="bg-col bg-col--b">
            <h3 class="col-title">Tools</h3>
            <dl class="toolset">
              {
                herramientas.map((h) => (
                  <div>
                    <dt>{h.grupo}</dt>
                    <dd>{h.items}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>
      </div>
    </section>

  <section class="band contact" id="contact" aria-labelledby="contact-title">
    <div class="wrap">
      <div class="contact__grid">
        <h2 class="contact__title" id="contact-title">Looking for my first programming role.</h2>
        <div class="contact__side">
          <p>Write to me on LinkedIn or by email.</p>
          <a class="btn" href="https://www.linkedin.com/in/nixon-correa" target="_blank" rel="noopener noreferrer">Message me on LinkedIn</a>
          <div class="contact__links">
            <MailLink encoded="bW9jLmxpYW1nQGFlcnJvY25kbg==" />
            <a href="/cv">Resume</a>
            <a href="https://github.com/Nixonbit3" target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href="https://nixonbit3.itch.io" target="_blank" rel="noopener noreferrer">itch.io</a>
          </div>
        </div>
      </div>
    </div>
  </section>
  </main>

  <Footer />
</Layout>

<script>
  import "../scripts/fx.js";
</script>
