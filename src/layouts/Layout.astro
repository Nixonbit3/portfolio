---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Imagen de vista previa; ruta desde la raíz del sitio */
  image?: string;
}

const {
  title = "Nixon Correa — Junior Developer",
  description =
    "Junior developer with a games background, open to any programming role. Two shipped mobile games and a published Unity tool, built solo in C#. Barcelona or remote.",
  noindex = false,
  image = "/og.jpg",
} = Astro.props;

const base = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, base);

// Las redes sociales exigen URL absoluta para la imagen de vista previa
const ogImage = new URL(image, base);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ff5a1f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Precarga de la fuente: evita el parpadeo de texto al cargar -->
    <link
      rel="preload"
      href="/fonts/archivo-latin-wdth-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonical} />

    <!-- Vista previa al compartir el enlace (email, LinkedIn, WhatsApp...) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nixon Correa" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Nixon Correa, junior developer. Air Bomb, a mobile game shipped on Android."
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />

    <script>
      import "../scripts/i18n.js";
      import "../scripts/mail.js";
    </script>
  </body>
</html>
